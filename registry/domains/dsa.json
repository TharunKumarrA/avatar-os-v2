{
  "schema_version": 1,
  "id": "dsa",
  "version": "1.0.0",
  "daily_close_prompt": "DSA session and problems",
  "events": {
    "dsa.session_logged.v1": {
      "publishers": ["user", "katara"],
      "fields": {
        "completed": {"type": "boolean"},
        "minutes": {"type": "number", "minimum": 0},
        "problems": {"type": "integer", "minimum": 0},
        "topic": {"type": "string"},
        "next_action": {"type": "string"}
      },
      "required": ["completed"],
      "projections": [
        {"target": "daily", "operation": "merge", "rename": {"completed": "dsa", "minutes": "dsa_minutes", "problems": "dsa_problems", "topic": "dsa_topic"}},
        {"target": "state", "operation": "merge", "rename": {"next_action": "next_dsa"}}
      ]
    }
  },
  "views": {
    "daily": [
      {"label": "DSA", "path": "dsa"},
      {"label": "DSA problems", "path": "dsa_problems"}
    ],
    "weekly": [
      {"label": "DSA days", "path": "dsa", "operation": "count_truthy"},
      {"label": "DSA problems", "path": "dsa_problems", "operation": "sum"}
    ],
    "state": [{"label": "NEXT DSA", "path": "next_dsa"}]
  }
}
