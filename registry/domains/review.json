{
  "schema_version": 1,
  "id": "review",
  "version": "1.0.0",
  "events": {
    "review_proposal": {
      "publishers": ["iroh"],
      "fields": {
        "proposal_id": {"type": "string"},
        "proposal": {"type": "string"},
        "evidence": {"type": "string"},
        "status": {"type": "string"}
      },
      "required": ["proposal_id", "proposal"],
      "projections": [{"target": "proposals", "operation": "upsert", "key": "proposal_id"}]
    },
    "decision": {
      "publishers": ["user", "katara"],
      "fields": {
        "proposal_id": {"type": "string"},
        "decision": {"type": "string"},
        "note": {"type": "string"}
      },
      "required": ["proposal_id", "decision"],
      "projections": [{"target": "proposals", "operation": "merge", "key": "proposal_id"}]
    }
  },
  "views": {"daily": [], "weekly": [], "state": []}
}
